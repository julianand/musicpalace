generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model product_categories {
  created_at       DateTime   @default(now()) @db.Timestamptz(6)
  name             String
  background_color String
  accent_color     String
  id               BigInt     @id(map: "product_category_pkey") @default(autoincrement())
  products         products[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model products {
  id                    BigInt             @id @default(autoincrement())
  created_at            DateTime           @default(now()) @db.Timestamptz(6)
  name                  String
  category_id           BigInt
  price                 Int
  description           String
  slug                  String             @unique
  overall_sound_quality Float?
  overall_build_quality Float?
  overall_value         Float?
  overall_ease_of_use   Float?
  overall_rating        Float?
  review_count          BigInt?
  product_categories    product_categories @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviews               reviews[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model reviews {
  id            BigInt   @id @default(autoincrement())
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  sound_quality Int      @db.SmallInt
  build_quality Int      @db.SmallInt
  value         Int      @db.SmallInt
  ease_of_use   Int      @db.SmallInt
  user_id       BigInt
  product_id    BigInt
  overall       Float    @default(dbgenerated("round((((((sound_quality + build_quality) + value) + ease_of_use))::numeric / 4.0), 1)"))
  comment       String?
  products      products @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users         users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id         BigInt    @id @default(autoincrement())
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  firstname  String
  lastname   String
  email      String    @unique
  reviews    reviews[]
}
